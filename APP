class TemperatureGauge(MDCard):
    value = NumericProperty(-1.0)
    label = StringProperty("SENSOR")
    status_text = StringProperty("Offline")
    status_color = [0.41, 0.56, 0.65, 1]

    def __init__(self, **kwargs):
        super().__init__(**kwargs)
        self.bind(value=self.on_value_change)

    def on_value_change(self, instance, val):
        if val < 0:
            self.status_text = "Offline"
            self.status_color = [0.41, 0.56, 0.65, 1]
        elif val < 30:
            self.status_text = "Cold"
            self.status_color = [0.13, 0.59, 0.95, 1]
        elif val < 50:
            self.status_text = "Optimal"
            self.status_color = [0.0, 0.9, 0.63, 1]
        elif val < 70:
            self.status_text = "Warm"
            self.status_color = [1, 0.65, 0.01, 1]
        else:
            self.status_text = "Hot"
            self.status_color = [1, 0.27, 0.34, 1]

        self.draw_gauge()

    def draw_gauge(self):
        widget = self.ids.gauge_widget
        widget.canvas.before.clear()

        w, h = widget.size
        cx, cy = widget.center_x, widget.center_y
        radius = min(w, h) / 2 - 10

        with widget.canvas.before:
            Color(0.11, 0.22, 0.37, 1)
            Line(circle=(cx, cy, radius, 0, 360), width=4)

            if self.value >= 0:
                pct = min(max(self.value / 100.0, 0.0), 1.0)
                angle_end = pct * 360
                Color(*self.status_color)
                Line(circle=(cx, cy, radius, 0, angle_end), width=4)


class BioreactorApp(MDApp):
    is_connected = BooleanProperty(False)
    is_connecting = BooleanProperty(False)
    is_running = BooleanProperty(False)

    t1_val = NumericProperty(-1.0)
    t2_val = NumericProperty(-1.0)

    air1_on = BooleanProperty(False)
    air2_on = BooleanProperty(False)

    status_msg = StringProperty("Disconnected — Tap Connect")

    bt_socket = None
    input_stream = None
    output_stream = None
    rx_thread = None
    stop_rx = False

    def build(self):
        self.theme_cls.theme_style = "Dark"
        self.theme_cls.primary_palette = "Blue"
        return Builder.load_string(KV)

    def toggle_connection(self):
        if self.is_connected:
            self.disconnect_bt()
        else:
            self.connect_bt()

    def connect_bt(self):
        if not ANDROID_BT_AVAILABLE:
            self.status_msg = "Error: Android Bluetooth API not available"
            return

        self.is_connecting = True
        self.status_msg = "Connecting to HC-05 Module..."
        threading.Thread(target=self._connect_thread, daemon=True).start()

    def _connect_thread(self):
        try:
            adapter = BluetoothAdapter.getDefaultAdapter()
            if not adapter or not adapter.isEnabled():
                Clock.schedule_once(lambda dt: self._on_connect_fail("Enable Bluetooth on Mobile!"), 0)
                return

            paired_devices = adapter.getBondedDevices().toArray()
            hc05_device = None

            for dev in paired_devices:
                name = dev.getName()
                if name and ("HC-05" in name or "HC-06" in name or "SystemUnite" in name):
                    hc05_device = dev
                    break

            if not hc05_device:
                Clock.schedule_once(lambda dt: self._on_connect_fail("HC-05 not found! Pair it in phone Bluetooth Settings."), 0)
                return

            uuid = UUID.fromString(UUID_SPP)
            self.bt_socket = hc05_device.createRfcommSocketToServiceRecord(uuid)
            adapter.cancelDiscovery()
            self.bt_socket.connect()

            self.input_stream = self.bt_socket.getInputStream()
            self.output_stream = self.bt_socket.getOutputStream()

            self.stop_rx = False
            self.rx_thread = threading.Thread(target=self._listen_data, daemon=True)
            self.rx_thread.start()

            Clock.schedule_once(lambda dt: self._on_connect_success(hc05_device.getName()), 0)

        except Exception as e:
            Clock.schedule_once(lambda dt: self._on_connect_fail("Connection Failed! Retry."), 0)

    def _on_connect_success(self, dev_name):
        self.is_connecting = False
        self.is_connected = True
        self.status_msg = f"Connected: {dev_name}"

    def _on_connect_fail(self, error):
        self.is_connecting = False
        self.is_connected = False
        self.status_msg = error

    def send_bt_data(self, data_str):
        if self.is_connected and self.output_stream:
            try:
                self.output_stream.write(bytes(data_str + "\n", 'utf-8'))
                self.output_stream.flush()
            except Exception as e:
                self.status_msg = f"Send Error: {e}"

    def _listen_data(self):
        buffer = ""
        while not self.stop_rx and self.is_connected:
            try:
                if self.input_stream.available() > 0:
                    b = self.input_stream.read()
                    char = chr(b)
                    if char == '\n':
                        self._parse_incoming_data(buffer.strip())
                        buffer = ""
                    else:
                        buffer += char
                else:
                    time.sleep(0.05)
            except Exception:
                break

    def _parse_incoming_data(self, raw_line):
        try:
            if raw_line.startswith("T1:"):
                val = float(raw_line.replace("T1:", "").strip())
                Clock.schedule_once(lambda dt, v=val: setattr(self, 't1_val', v), 0)
            elif raw_line.startswith("T2:"):
                val = float(raw_line.replace("T2:", "").strip())
                Clock.schedule_once(lambda dt, v=val: setattr(self, 't2_val', v), 0)
        except Exception:
            pass

    def disconnect_bt(self):
        self.stop_rx = True
        try:
            if self.bt_socket:
                self.bt_socket.close()
        except Exception:
            pass

        self.is_connected = False
        self.is_running = False
        self.air1_on = False
        self.air2_on = False
        self.t1_val = -1.0
        self.t2_val = -1.0
        self.status_msg = "Disconnected"

    # أزرار الإرسال المطابقة لكود الأردوينو
    def send_parameters(self):
        target_temp = self.root.ids.target_temp_input.text
        op_time = self.root.ids.op_time_input.text

        if target_temp:
            self.send_bt_data(f"TEMP:{target_temp}")
            time.sleep(0.1)
        if op_time:
            self.send_bt_data(f"TIME:{op_time}")

        self.show_dialog("Parameters Sent", f"Transmitted to Arduino:\nTEMP:{target_temp}\nTIME:{op_time}")

    def toggle_air1(self):
        self.air1_on = not self.air1_on
        cmd = "AIR1:ON" if self.air1_on else "AIR1:OFF"
        self.send_bt_data(cmd)

    def toggle_air2(self):
        self.air2_on = not self.air2_on
        cmd = "AIR2:ON" if self.air2_on else "AIR2:OFF"
        self.send_bt_data(cmd)

    def start_run(self):
        self.is_running = True
        self.status_msg = "Bioreactor Process Running..."
        self.send_bt_data("START")

    def stop_run(self):
        self.is_running = False
        self.status_msg = "Process Stopped."
        self.send_bt_data("STOP")

    def show_dialog(self, title, text):
        dialog = MDDialog(
            title=title,
            text=text,
            buttons=[MDFlatButton(text="OK", on_release=lambda x: dialog.dismiss())]
        )
        dialog.open()

if __name__ == '__main__':
    BioreactorApp().run()
